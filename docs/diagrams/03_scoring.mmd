flowchart TD
    A(["Ответ студента"]) --> B{"Ответ пустой?"}
    B -- да --> X0["Неверно<br/>(нет ответа)"]
    B -- нет --> C["Эмбеддинги ответа и эталонов<br/>(ruBERT-tiny2)"]
    C --> D["s = максимальное косинусное<br/>сходство с эталонами"]
    D --> E{"s ≥ порог T?<br/>(по умолчанию 0.71)"}
    E -- да --> F{"Число отрицаний в ответе<br/>совпадает хотя бы с одним эталоном?"}
    F -- да --> OK["Верно"]
    F -- нет --> RV["На проверку преподавателю<br/>«возможно, смысл перевёрнут»"]
    E -- нет --> G{"s ≥ T − δ?<br/>(серая зона, δ = 0.03)"}
    G -- да --> RV2["На проверку преподавателю<br/>«оценка близка к порогу»"]
    G -- нет --> X["Неверно"]
    RV --> P["Преподаватель: засчитать / не засчитать"]
    RV2 --> P
    P --> Q["Пересчёт итога попытки"]
